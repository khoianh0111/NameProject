{
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Transforms": [
          {
             "PathRemovePrefix": "/api/identity"
          },
          {
             "PathPrefix": "/api"
          }
    
        ]
      },
      "resource-route": {
        "ClusterId": "resource-cluster",
        "Match": {
          "Path": "/api/resource/{**catch-all}"
        },
        "Transforms": [
          {
           "PathRemovePrefix": "/api/resource"
         },
         {
          "PathPrefix": "/api"
       }
    ]
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/booking/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/booking"
          },
          {
            "PathPrefix": "/api"
          }
  
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        },
       "Transforms": [
        {
          "PathRemovePrefix": "/api/payment"
        },
        {
          "PathPrefix": "/api"
        }
      ]
      },
      "community-route": {
        "ClusterId": "community-cluster",
        "Match": {
          "Path": "/api/community/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/community"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/ai"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://identity:8080/"
          }
        }
      },
      "resource-cluster": {
        "Destinations": {
          "resource": {
            "Address": "http://resource:8080/"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "booking": {
            "Address": "http://booking:8080/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment": {
            "Address": "http://payment:8080/"
          }
        }
      },
      "community-cluster": {
        "Destinations": {
          "community": {
            "Address": "http://community:8080/"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "ai": {
            "Address": "http://ai:8000/"
          }
        }
      }
    }
  }
}